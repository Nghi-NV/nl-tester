{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlt-corp.github.io/lumi-tester/schema/lumi-test.schema.json",
  "title": "Lumi Tester Flow",
  "description": "Schema for Lumi Tester YAML flows. Command names are kept in sync with src/parser/yaml.rs; command parameters are intentionally permissive for forward compatibility.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "appId": { "type": "string" },
    "url": { "type": "string" },
    "platform": {
      "type": "string",
      "enum": ["android", "android_auto", "ios", "iOS", "web", "macos", "macOS", "windows"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "defaultTimeout": {
      "type": "integer",
      "minimum": 0
    },
    "speed": {
      "type": "string",
      "enum": ["turbo", "fast", "normal", "safe"]
    },
    "browser": {
      "type": "string",
      "enum": ["Chrome", "Firefox", "Webkit", "chrome", "firefox", "webkit", "chromium"]
    },
    "closeWhenFinish": { "type": "boolean" },
    "desktopState": { "$ref": "#/$defs/desktopState" },
    "env": { "$ref": "#/$defs/env" },
    "vars": { "$ref": "#/$defs/envMap" },
    "var": { "$ref": "#/$defs/envMap" },
    "camera": { "$ref": "#/$defs/cameraConfig" },
    "cameras": { "$ref": "#/$defs/camerasConfig" },
    "data": { "type": "string" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "anyOf": [
    { "required": ["steps"] },
    { "required": ["commands"] }
  ],
  "$defs": {
    "env": {
      "oneOf": [
        { "$ref": "#/$defs/envMap" },
        {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "envMap": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "cameraConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rtsp": { "type": "string" },
        "profile": { "type": "string" },
        "transport": {
          "type": "string",
          "enum": ["tcp", "udp", "TCP", "UDP"]
        },
        "timeoutMs": { "type": "integer", "minimum": 0 }
      }
    },
    "camerasConfig": {
      "oneOf": [
        { "$ref": "#/$defs/cameraConfig" },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/cameraConfig" }
        }
      ]
    },
    "desktopState": {
      "type": "object",
      "properties": {
        "clear": { "$ref": "#/$defs/desktopClear" }
      },
      "additionalProperties": true
    },
    "desktopClear": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["autoSafe", "manual"]
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keychainServices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "registryKeys": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "commandName": {
      "type": "string",
      "enum": [
        "addCctPoint",
        "airplaneMode",
        "assert",
        "assertClipboard",
        "assertColor",
        "assertDeviceChange",
        "assertDevicePattern",
        "assertDeviceState",
        "assertDeviceTransition",
        "assertNotVisible",
        "assertPerformance",
        "assertScreenshot",
        "assertTrue",
        "assertVar",
        "assertVisible",
        "await",
        "back",
        "backgroundApp",
        "buildGif",
        "calibrateBrightness",
        "calibrateColor",
        "captureFrame",
        "captureGifFrame",
        "checkColor",
        "checkDevice",
        "clear",
        "clearAppData",
        "click",
        "clickButton",
        "colorState",
        "conditional",
        "configureServo",
        "connectJig",
        "contextClick",
        "copyTextFrom",
        "createGif",
        "dbQuery",
        "deepLink",
        "disconnectJig",
        "display",
        "doubleTap",
        "doubleTapOn",
        "enterSafeState",
        "eraseCalibration",
        "eraseText",
        "evalScript",
        "execPython",
        "exportReport",
        "extendedWaitUntil",
        "find",
        "generate",
        "getClipboard",
        "getDeviceState",
        "getRelayState",
        "getSensorLightState",
        "getServoState",
        "gps",
        "hideKbd",
        "hideKeyboard",
        "hold",
        "holdButton",
        "home",
        "httpRequest",
        "inputAt",
        "inputRandomEmail",
        "inputRandomNumber",
        "inputRandomPersonName",
        "inputRandomPhoneNumber",
        "inputRandomText",
        "inputText",
        "installApp",
        "lark",
        "launchApp",
        "lightState",
        "loadCalibration",
        "locale",
        "lockDevice",
        "longPress",
        "longPressOn",
        "mockLocation",
        "mockLocationControl",
        "navigate",
        "notSee",
        "open",
        "openLink",
        "openNotifications",
        "openQuickSettings",
        "pasteText",
        "playMedia",
        "powerCycle",
        "press",
        "pressButton",
        "pressHome",
        "pressKey",
        "pullFile",
        "pushFile",
        "python",
        "readColor",
        "readColorSensor",
        "readRelay",
        "readSensorLight",
        "readServo",
        "release",
        "releaseAll",
        "releaseAllButtons",
        "releaseButton",
        "relayAllOff",
        "relayOff",
        "relayOn",
        "relayState",
        "repeat",
        "repeatClick",
        "resetCalibration",
        "retry",
        "rightClick",
        "rotate",
        "rotateScreen",
        "rotateServo",
        "runFlow",
        "runPython",
        "runScript",
        "saveCalibration",
        "screenshot",
        "scrollTo",
        "scrollUntilVisible",
        "see",
        "seeLedBlink",
        "seeLedColor",
        "seeLedOff",
        "selectDisplay",
        "sendLarkMessage",
        "sendlarkmessage",
        "sensorLight",
        "servoRotate",
        "servoState",
        "setBrightnessThresholds",
        "setClipboard",
        "setCpuThrottling",
        "setLocale",
        "setNetwork",
        "setNetworkConditions",
        "setOrientation",
        "setSensorLight",
        "setServoConfig",
        "setVar",
        "setVolume",
        "snapshot",
        "startAudioCapture",
        "startGifCapture",
        "startProfiling",
        "startRecording",
        "startRepeatClick",
        "stop",
        "stopApp",
        "stopAudioCapture",
        "stopGifCapture",
        "stopGps",
        "stopMedia",
        "stopMockLocation",
        "stopProfiling",
        "stopRecord",
        "stopRecording",
        "stopRepeatClick",
        "swipe",
        "swipeDown",
        "swipeLeft",
        "swipeRight",
        "swipeUp",
        "systemDiagnostics",
        "takeScreenshot",
        "takeSnapshot",
        "tap",
        "tapAt",
        "tapOn",
        "toggleAirplaneMode",
        "turnOff",
        "turnOffAll",
        "turnOn",
        "type",
        "uninstallApp",
        "unlockDevice",
        "verifyAudioDucking",
        "wait",
        "waitDeviceState",
        "waitForAnimationToEnd",
        "waitForBrightness",
        "waitForCct",
        "waitForLocation",
        "waitForMockCompletion",
        "waitLedPattern",
        "waitNotSee",
        "waitSee",
        "waitUntilNotVisible",
        "waitUntilVisible",
        "write"
      ]
    },
    "command": {
      "oneOf": [
        { "$ref": "#/$defs/commandName" },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": { "$ref": "#/$defs/commandName" },
          "additionalProperties": { "$ref": "#/$defs/commandParams" }
        }
      ]
    },
    "commandParams": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "integer" },
        { "type": "boolean" },
        { "$ref": "#/$defs/selector" },
        { "$ref": "#/$defs/commandArray" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        }
      ]
    },
    "commandArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "value": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "integer" },
        { "type": "boolean" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/value" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "label": { "type": "string" },
        "element": { "type": "string" },
        "text": { "type": "string" },
        "regex": { "type": "string" },
        "id": { "type": "string" },
        "resourceId": { "type": "string" },
        "desc": { "type": "string" },
        "description": { "type": "string" },
        "contentDesc": { "type": "string" },
        "accessibilityId": { "type": "string" },
        "css": { "type": "string" },
        "xpath": { "type": "string" },
        "role": { "type": "string" },
        "placeholder": { "type": "string" },
        "type": { "type": "string" },
        "elementType": { "type": "string" },
        "point": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "exact": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "timeout": { "type": "integer", "minimum": 0 },
        "soft": { "type": "boolean" },
        "image": { "type": "string" },
        "imageRegion": { "type": "string" },
        "ocr": { "$ref": "#/$defs/ocrSelector" },
        "relative": { "$ref": "#/$defs/relativeSelector" },
        "rightOf": { "$ref": "#/$defs/anchor" },
        "leftOf": { "$ref": "#/$defs/anchor" },
        "above": { "$ref": "#/$defs/anchor" },
        "below": { "$ref": "#/$defs/anchor" },
        "scrollable": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "index": { "type": "integer", "minimum": 0 },
                "itemIndex": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            }
          ]
        },
        "containsChild": { "$ref": "#/$defs/selector" },
        "contains_child": { "$ref": "#/$defs/selector" },
        "commands": { "$ref": "#/$defs/commandArray" },
        "then": { "$ref": "#/$defs/commandArray" },
        "else": { "$ref": "#/$defs/commandArray" }
      }
    },
    "ocrSelector": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "index": { "type": "integer", "minimum": 0 },
            "region": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "relativeSelector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rightOf": { "$ref": "#/$defs/anchor" },
        "leftOf": { "$ref": "#/$defs/anchor" },
        "above": { "$ref": "#/$defs/anchor" },
        "below": { "$ref": "#/$defs/anchor" },
        "maxDist": { "type": "integer", "minimum": 0 },
        "maxDistance": { "type": "integer", "minimum": 0 }
      }
    },
    "anchor": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "element": { "type": "string" },
            "text": { "type": "string" },
            "regex": { "type": "string" },
            "textRegex": { "type": "string" },
            "id": { "type": "string" },
            "resourceId": { "type": "string" },
            "desc": { "type": "string" },
            "contentDesc": { "type": "string" },
            "accessibilityId": { "type": "string" },
            "css": { "type": "string" },
            "xpath": { "type": "string" },
            "placeholder": { "type": "string" },
            "role": { "type": "string" },
            "type": { "type": "string" },
            "image": { "type": "string" },
            "exact": { "type": "boolean" },
            "index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "colorName": {
      "type": "string",
      "enum": [
        "RED",
        "GREEN",
        "BLUE",
        "YELLOW",
        "CYAN",
        "MAGENTA",
        "PINK",
        "WHITE",
        "OFF"
      ]
    }
  }
}
